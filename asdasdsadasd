        local okPos = pcall(function()
            local ap, az = btn.AbsolutePosition, btn.AbsoluteSize
            local gy = 0
            pcall(function()
                if not screenGui.IgnoreGuiInset then
                    gy = game:GetService("GuiService"):GetGuiInset().Y
                end
            end)
            local x = ap.X + az.X - dropdownWidth
            local y = ap.Y + az.Y + 2
            -- если снизу нет места — раскрываем вверх
            local listH = listFrame.AbsoluteSize.Y
            local screenH = screenGui.AbsoluteSize.Y
            if listH > 0 and (y + listH) > screenH then
                y = ap.Y - listH - 2
            end
            listFrame.Position = UDim2.fromOffset(x, y - gy)
        end)
        return okPos
    end

    local function refreshLayout()
        recalcWidth()
        label.Size = UDim2.new(1, -(dropdownWidth + 8), 1, 0)
        btn.Size = UDim2.new(0, dropdownWidth, 0, 16)
        btn.Position = UDim2.new(1, -2, 0.5, 0)
        valueLabel.Size = UDim2.new(1, -18, 1, 0)
        valueLabel.Position = UDim2.new(0, 2, 0, 0)
        arrowLabel.Position = UDim2.new(1, -4, 0.5, 0)
        listFrame.Size = UDim2.new(0, dropdownWidth, 0, 0)
        anchorList()
    end

    local function populateOptions()
        refreshLayout()
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for _, opt in ipairs(options) do
            local isSelected = (opt == selected)
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, 18)
            optBtn.BackgroundTransparency = isSelected and 0.82 or 1
            optBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            optBtn.Text = tostring(opt)
            optBtn.FontFace = UI_FONT
            optBtn.TextSize = 10
            optBtn.TextColor3 = COLORS.AccentGlow
            optBtn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            optBtn.TextStrokeTransparency = 0
            optBtn.TextXAlignment = Enum.TextXAlignment.Center
            optBtn.AutoButtonColor = false
            optBtn.ClipsDescendants = true
            optBtn.ZIndex = 102
            optBtn.Parent = listFrame

            local optCorner = Instance.new("UICorner")
            optCorner.CornerRadius = UDim.new(0, 0)
            optCorner.Parent = optBtn

            optBtn.MouseEnter:Connect(function()
                if not isSelected then
                    tween(optBtn, {BackgroundTransparency = 0.9, TextColor3 = Color3.fromRGB(235, 55, 80)}, 0.12)
                end
            end)

            optBtn.MouseLeave:Connect(function()
                if not isSelected then
                    tween(optBtn, {BackgroundTransparency = 1, TextColor3 = COLORS.AccentGlow}, 0.12)
                end
            end)

            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                valueLabel.Text = tostring(selected)
                isOpen = false
                arrowLabel.Text = "∨"
                listFrame.Visible = false
                row.ZIndex = 50
                populateOptions()
                if callback then
                    callback(selected)
                end
            end)
        end
    end

    refreshLayout()
    populateOptions()

    -- список висит поверх UI -> держим его приклеенным к кнопке
    pcall(function()
        btn:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if isOpen then anchorList() end
        end)
    end)

    btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            -- закрываем все остальные открытые списки
            for _, other in ipairs(screenGui:GetChildren()) do
                if other:IsA("Frame") and other.Name == "OptionList" and other ~= listFrame then
                    other.Visible = false
                end
            end
            listFrame.Visible = true
            anchorList()
            task.defer(anchorList)
            row.ZIndex = 100
            listFrame.ZIndex = 10000
            arrowLabel.Text = "∧"
        else
            listFrame.Visible = false
            row.ZIndex = 50
            arrowLabel.Text = "∨"
        end
    end)

    -- список скрывается вместе со своей вкладкой / меню
    pcall(function()
        row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if isOpen then anchorList() end
        end)
        container:GetPropertyChangedSignal("Visible"):Connect(function()
            if not container.Visible then isOpen = false; listFrame.Visible = false end
        end)
    end)

    return {
        setValue = function(newVal)
            selected = newVal
            valueLabel.Text = tostring(selected)
            arrowLabel.Text = isOpen and "∧" or "∨"
            populateOptions()
        end,
        getValue = function()
            return selected
        end,
        refreshOptions = function(newOpts)
            options = newOpts
            selected = options[1] or "None"
            valueLabel.Text = tostring(selected)
            arrowLabel.Text = "∨"
            populateOptions()
        end
    }
end




