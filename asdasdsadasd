local FONT_APPLIED = {}
local function applyUIFont(object)
    if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
        return
    end
    if FONT_APPLIED[object] then return end
    FONT_APPLIED[object] = true
    object.FontFace = UI_FONT
    if not object:GetAttribute("NoFontScale") then
        -- TextSize is explicitly controlled by UI widgets for crisp rendering
    end
    -- Enable crisp black outline on all UI text items automatically
    if not object:FindFirstChildOfClass("UIStroke") then
        local st = Instance.new("UIStroke")
        st.Color = Color3.fromRGB(0, 0, 0)
        st.Thickness = 1.0
        st.Transparency = 0
        st.Parent = object
    end
end

