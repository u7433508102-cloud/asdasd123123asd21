local function getPlayerPriority(player)
	if not player then return "Neutral" end
	local success, priority = true, "Neutral"
	if success and priority then return priority end
	return "Neutral"
end

local function canTargetPlayer(player)
	if not player or player == client then return false end
	local priority = getPlayerPriority(player)
	if priority == "Friendly" then return false end
	local hasEnemies = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= client and getPlayerPriority(p) == "Enemy" then hasEnemies = true; break; end
	end
	if hasEnemies then return priority == "Enemy" end
	return priority == "Neutral"
end

local function isPartValid(part) return part and part:IsA("BasePart") end

local function isPartOnScreen(part)
	local _, onScreen = camera:WorldToScreenPoint(part.Position)
	return onScreen
end

local function getMagnitudeFromMouse(part)
	local screenPos = camera:WorldToScreenPoint(part.Position)
	return (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
end

local function getClosestBodyPart(character)
	local distance = math.huge
	local closestPart = nil
	if not (character and character:IsA("Model")) then return nil end
	for _, part in pairs(character:GetChildren()) do
		if isPartValid(part) and isPartOnScreen(part) then
			local magnitude = getMagnitudeFromMouse(part)
			if magnitude < distance then closestPart = part; distance = magnitude; end
		end
	end
	return closestPart
end

local function isPlayerKO(player)
	if not player or not player.Character then return true end
	local humanoid = player.Character:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return true end
	if getgenv().ARCHNEM.aimbot.Settings.KnockCheck then
		local bodyEffects = player.Character:FindFirstChild("BodyEffects")
		if bodyEffects then
			local koCheck = bodyEffects:FindFirstChild("K.O")
			if koCheck and koCheck.Value then return true end
		end
		if player.Character:FindFirstChild("GRABBING_CONSTRAINT") then return true end
	end
	return false
end

local function getNearestPlayerInAimbotFOV()
	local minDistance = getgenv().ARCHNEM.aimbot.Settings.FOV.Radius
	local closest = nil
	for _, player in ipairs(Players:GetPlayers()) do
		if player == client then continue end
		if not canTargetPlayer(player) then continue end
		if isPlayerKO(player) then continue end
		if getgenv().ARCHNEM.aimbot.Settings.CheckIfTargetDead then
			local char = player.Character
			if char then
				local hum = char:FindFirstChild("Humanoid")
				if hum and hum.Health < 4 then continue end
			end
		end
		local char = player.Character
		if not char then continue end
		local part = char:FindFirstChild(getgenv().ARCHNEM.aimbot.Settings.Part)
		if not part then continue end
		if getgenv().ARCHNEM.aimbot.Settings.WallCheck and not rayCastCheck(part, char) then continue end
		local screenPos, onScreen = camera:WorldToScreenPoint(part.Position)
		if not onScreen then continue end
		local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
		if dist < minDistance then minDistance = dist; closest = player; end
	end
	return closest
end

local function getNearestPlayerInFOV()
	local minDistance = getgenv().ARCHNEM.silent.Settings.Visuals.FOVRadius
	local closest = nil
	for _, player in ipairs(Players:GetPlayers()) do
		if player == client then continue end
		if not canTargetPlayer(player) then continue end
		if isPlayerKO(player) then continue end
		local char = player.Character
		if not char then continue end
		local part = char:FindFirstChild(getgenv().ARCHNEM.silent.Settings.Part)
		if not part then continue end
		if getgenv().ARCHNEM.aimbot.Settings.WallCheck and not rayCastCheck(part, char) then continue end
		local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
		if not onScreen then continue end
		local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
		if dist < minDistance then minDistance = dist; closest = player; end
	end
	return closest
end

