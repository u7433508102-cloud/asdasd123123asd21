-- FONT CONFIGURATION & CUSTOM MONOCRAFT LOADER (FROM ARCHNEM UI)
-- ==============================================================================

local FONT_CONFIG = {
    Name = "Monocraft",
    Url = "https://raw.githubusercontent.com/IdreesInc/Monocraft/main/dist/Monocraft-ttf/Monocraft.ttf",
    Folder = "archnem_fonts",
    Weight = 400,
    Fallback = "rbxasset://fonts/families/PressStart2P.json",
    TextSizeScale = 1.0,
    MinTextSize   = 12,
    ForceRedownload = false,
}

local UI_FONT
local FONT_SOURCE = "?"

do
    local _writefile   = rawget(getfenv(), "writefile")   or writefile
    local _isfile      = rawget(getfenv(), "isfile")      or isfile
    local _isfolder    = rawget(getfenv(), "isfolder")    or isfolder
    local _makefolder  = rawget(getfenv(), "makefolder")  or makefolder
    local _getcustom   = rawget(getfenv(), "getcustomasset")
                      or rawget(getfenv(), "getsynasset")
                      or getcustomasset
    local syn          = rawget(getfenv(), "syn")
    local request      = rawget(getfenv(), "request")
    local http_request = rawget(getfenv(), "http_request")

    local function safeFont(family, weight, style)
        local ok, f = pcall(function()
            return Font.new(family, weight or Enum.FontWeight.Regular,
                            style or Enum.FontStyle.Normal)
        end)
        if ok and f then return f end
        return nil
    end

    local function loadCustomFont()
        if not (_writefile and _getcustom) then
            warn("[Archnem] Экзекьютор не поддерживает writefile/getcustomasset")
            return nil
        end

        local folder  = FONT_CONFIG.Folder
        local ttfPath  = folder .. "/" .. FONT_CONFIG.Name .. ".ttf"
        local jsonPath = folder .. "/" .. FONT_CONFIG.Name .. ".json"

        if _makefolder and _isfolder and not _isfolder(folder) then
            pcall(_makefolder, folder)
        elseif _makefolder and not _isfolder then
            pcall(_makefolder, folder)
        end

        local needDownload = FONT_CONFIG.ForceRedownload
            or not (_isfile and _isfile(ttfPath))

        if needDownload then
            local ok, data = pcall(function()
                if syn and syn.request then
                    return syn.request({ Url = FONT_CONFIG.Url, Method = "GET" }).Body
                elseif request then
                    return request({ Url = FONT_CONFIG.Url, Method = "GET" }).Body
                elseif http_request then
                    return http_request({ Url = FONT_CONFIG.Url, Method = "GET" }).Body
                else
                    return game:HttpGet(FONT_CONFIG.Url, true)
                end
            end)

            if not ok or type(data) ~= "string" or #data < 1000 then
                warn("[Archnem] Не удалось скачать шрифт:", tostring(data))
                return nil
            end

            local okw = pcall(_writefile, ttfPath, data)
            if not okw then
                warn("[Archnem] writefile для .ttf не сработал")
                return nil
            end
        end

        local okA, ttfAsset = pcall(_getcustom, ttfPath)
        if not okA or not ttfAsset then
            warn("[Archnem] getcustomasset для .ttf не сработал")
            return nil
        end

        local familyJson = string.format(
            '{"name":"%s","faces":[{"name":"Regular","weight":%d,"style":"normal","assetId":"%s"}]}',
            FONT_CONFIG.Name, FONT_CONFIG.Weight, ttfAsset
        )
        local okj = pcall(_writefile, jsonPath, familyJson)
        if not okj then
            warn("[Archnem] writefile для .json не сработал")
            return nil
        end

        local okB, jsonAsset = pcall(_getcustom, jsonPath)
        if not okB or not jsonAsset then
            warn("[Archnem] getcustomasset для .json не сработал")
            return nil
        end

        return safeFont(jsonAsset)
    end

    local ok, result = pcall(loadCustomFont)
    if ok and result then
        UI_FONT = result
        FONT_SOURCE = FONT_CONFIG.Name .. " (custom ttf)"
    end

    if not UI_FONT then
        UI_FONT = safeFont(FONT_CONFIG.Fallback)
        if UI_FONT then FONT_SOURCE = "Press Start 2P (fallback)" end
    end

    if not UI_FONT then
        UI_FONT = Font.fromEnum(Enum.Font.Arcade)
        FONT_SOURCE = "Arcade (last resort)"
    end
end

