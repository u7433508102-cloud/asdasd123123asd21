local function ensureVariants(packName)
	if not _G.__ARCHNEM_VARIANTS then _G.__ARCHNEM_VARIANTS = {} end
	if _G.__ARCHNEM_VARIANTS[packName] then return _G.__ARCHNEM_VARIANTS[packName] end
	local pack = getgenv().ARCHNEM.misc.World.TexturePacks and getgenv().ARCHNEM.misc.World.TexturePacks[packName]
	if not pack or not pack.Textures then return {} end
	local variants = {}
	for idx, texUrl in ipairs(pack.Textures) do
		local cid = "rbxassetid://0"
		pcall(function()
			if texUrl:sub(1, 4) == "http" then
				local asset = getcustomasset or getsynasset
				if asset then
					local fname = "archnem_tex_" .. packName .. "_" .. idx .. ".png"
					if not (isfile and isfile(fname)) and writefile then
						local body = game:HttpGet(texUrl)
						writefile(fname, body)
					end
					if isfile and isfile(fname) then cid = asset(fname) end
				end
			else
				cid = texUrl
			end
		end)
		table.insert(variants, cid)
	end
	_G.__ARCHNEM_VARIANTS[packName] = variants
	return variants
end

local function shouldSkipTexturePart(part)
	if not part or not part:IsA("BasePart") then return true end
	if part.Transparency >= 0.9 then return true end
	if part.Name == "HumanoidRootPart" or part.Name == "Handle" then return true end
	if part:IsDescendantOf(Players.LocalPlayer.Character or game) then
		local p = part.Parent
		if p and p:FindFirstChildOfClass("Humanoid") then return true end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character and part:IsDescendantOf(p.Character) then return true end
	end
	return false
end

local function applyPartTexturePack(packName)
	local variants = ensureVariants(packName)
	if #variants == 0 then return end
	for _, desc in ipairs(workspace:GetDescendants()) do
		if shouldSkipTexturePart(desc) then continue end
		if desc:IsA("BasePart") and not desc:GetAttribute("ArchnemOrigColor") then
			desc:SetAttribute("ArchnemOrigColor", desc.Color)
			desc:SetAttribute("ArchnemOrigMat", desc.Material.Name)
			local tex = Instance.new("Texture")
			tex.Name = "ArchnemTex_" .. packName
			tex.Texture = variants[math.random(1, #variants)]
			tex.Face = Enum.NormalId.Top
			tex.StudsPerTileU = 8
			tex.StudsPerTileV = 8
			tex.Parent = desc
		end
	end
end

local function clearPartTexturePack()
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("BasePart") and desc:GetAttribute("ArchnemOrigColor") then
			desc.Color = desc:GetAttribute("ArchnemOrigColor")
			local matName = desc:GetAttribute("ArchnemOrigMat")
			if matName and Enum.Material[matName] then desc.Material = Enum.Material[matName] end
			desc:SetAttribute("ArchnemOrigColor", nil)
			desc:SetAttribute("ArchnemOrigMat", nil)
			for _, child in ipairs(desc:GetChildren()) do
				if child:IsA("Texture") and child.Name:sub(1, 11) == "ArchnemTex_" then
					child:Destroy()
				end
			end
		end
	end
end

local function clearVariants()
