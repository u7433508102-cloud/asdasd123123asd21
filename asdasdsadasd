function UI.switchTab(index)
    for i, tab in ipairs(UI.tabs) do
        tab.scrollFrame.Visible = (i == index)
        local btn = sidebarButtons[i]
        local bg = sidebarBgs[i]
        if btn and bg then
            -- полностью убираем фон как на фотке, оставляем только свечение иконки
            bg.Visible = false
            bg.BackgroundTransparency = 1
            if i == index then
                btn:SetAttribute("ActiveTab", true)
                -- активная вкладка красная, светится
                tween(btn, {ImageColor3 = Color3.fromRGB(235, 35, 60)}, 0.18)
            else
                btn:SetAttribute("ActiveTab", false)
                tween(btn, {ImageColor3 = COLORS.SidebarIcon}, 0.18)
            end
        end
    end
end

