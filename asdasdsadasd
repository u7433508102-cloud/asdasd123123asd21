    local function onEnter()
        local targetWidth = math.max(titleLabel.TextBounds.X, 25)
        tween(titleLine, {Size = UDim2.new(0, targetWidth, 0, 2)}, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
