local configDir = "ARCHNEM_CONFIGS/"
if makefolder and not isfolder(configDir) then
    pcall(function() makefolder(configDir) end)
end

local function get_config_list()
    local list = {}
    if isfolder and isfolder(configDir) and listfiles then
        for _, file in pairs(listfiles(configDir)) do
            local name = string.match(file, "([^/\\]+)%.cfg$")
            if name then table.insert(list, name) end
        end
    end
    if #list == 0 then table.insert(list, "Default") end
    return list
end

