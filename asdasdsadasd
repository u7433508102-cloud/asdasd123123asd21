    stroke.Thickness = 1
    stroke.Transparency = state and 0.65 or 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn

    -- легкий но заметный градиент для чекбокса
    local checkGradient = Instance.new("UIGradient")
    checkGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.0, Color3.fromRGB(235, 35, 60)), ColorSequenceKeypoint.new(1.0, Color3.fromRGB(0, 0, 0))}
    checkGradient.Rotation = -90
    checkGradient.Enabled = state
    checkGradient.Parent = btn

    local function updateVisuals()
        btn.Text = "" -- checkbox style
        if state then
            -- включено: плавная анимация + светло серая обводка только у включенных
            tween(btn, {BackgroundColor3 = Color3.fromRGB(95, 14, 28), Size = UDim2.new(0, 15, 0, 15), Position = UDim2.new(0, 1, 0.5, -7.5)}, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            tween(stroke, {Color = Color3.fromRGB(110, 110, 115), Thickness = 1, Transparency = 0.68}, 0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        else
            -- выключено: плавное уменьшение, обводка исчезает
            tween(btn, {BackgroundColor3 = COLORS.CheckboxBg, Size = UDim2.new(0, 13, 0, 13), Position = UDim2.new(0, 2, 0.5, -6.5)}, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            tween(stroke, {Transparency = 1, Thickness = 1}, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        end
        checkGradient.Enabled = state
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        updateVisuals()
        if callback then callback(state) end
    end)

    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            state = not state
            updateVisuals()
            if callback then callback(state) end
        end
    end)

    return {
        setState = function(newVal)
            state = newVal
            updateVisuals()
        end,
        getState = function() return state end
    }
end

function UI.addSlider(container, labelText, minVal, maxVal, defaultVal, isFloat, callback)
    local val = defaultVal or minVal
    val = math.clamp(val, minVal, maxVal)

    local row = Instance.new("Frame")
    row.Name = "Slider_" .. labelText
    row.Size = UDim2.new(1, 0, 0, 38)
