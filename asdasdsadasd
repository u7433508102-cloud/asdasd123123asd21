local espCache = {}

local function createDrawing(class, properties)
	local drawing = Drawing.new(class)
	for k, v in pairs(properties) do drawing[k] = v end
	return drawing
end

local function createEsp(player)
	espCache[player] = {
		boxOutline = createDrawing("Square", { Color = getgenv().ARCHNEM.esp.BoxOutlineColor, Thickness = 3, Filled = false }),
		box = createDrawing("Square", { Color = getgenv().ARCHNEM.esp.BoxColor, Thickness = 1, Filled = false }),
		filledBox = createDrawing("Square", { Color = getgenv().ARCHNEM.esp.FilledBoxColor, Thickness = 1, Transparency = 0.3, Filled = true }),
		name = createDrawing("Text", { Color = getgenv().ARCHNEM.esp.NameColor, Outline = true, Center = true, Size = 13 }),
		healthOutline = createDrawing("Line", { Thickness = 3, Color = getgenv().ARCHNEM.esp.HealthOutlineColor }),
		health = createDrawing("Line", { Thickness = 1 }),
		distance = createDrawing("Text", { Color = Color3.new(1, 1, 1), Size = 12, Outline = true, Center = true }),
		boxLines = {},
	}
end

local function isPlayerBehindWall(player)
	local character = player.Character
	if not character then return false end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return false end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {client.Character, character}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local result = workspace:Raycast(camera.CFrame.Position, (rootPart.Position - camera.CFrame.Position), params)
	return result ~= nil
end

local function removeEsp(player)
	local esp = espCache[player]
	if not esp then return end
	for _, drawing in pairs(esp) do
		if type(drawing) == "table" then
			for _, d in pairs(drawing) do if d and d.Remove then d:Remove() end end
		elseif drawing and drawing.Remove then drawing:Remove() end
	end
	espCache[player] = nil
end

local function hideEsp(esp)
	for _, drawing in pairs(esp) do
		if type(drawing) ~= "table" then drawing.Visible = false end
	end
	for _, line in ipairs(esp.boxLines) do line:Remove() end
	esp.boxLines = {}
end

local function lerp(a, b, t) return a + (b - a) * t end

local _healthLerp = {}

local function updateEsp()
	_espFrame = _espFrame + 1
	if _espFrame < 3 then return end
	_espFrame = 0
	local espConfig = getgenv().ARCHNEM.esp
	if not espConfig.Enabled then
		for _, esp in pairs(espCache) do hideEsp(esp) end
		return
	end
	for player, esp in pairs(espCache) do
		local character = player.Character
		if not character then hideEsp(esp); continue; end
		if espConfig.Teamcheck and player.Team and player.Team == client.Team then hideEsp(esp); continue; end
		if espConfig.WallCheck and isPlayerBehindWall(player) then hideEsp(esp); continue; end
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local head     = character:FindFirstChild("Head")
		local humanoid = character:FindFirstChild("Humanoid")
		if not (rootPart and head and humanoid) then hideEsp(esp); continue; end
		local hrp2D, onScreen = camera:WorldToViewportPoint(rootPart.Position)
		if not onScreen then hideEsp(esp); continue; end
		local topY    = camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 2.6, 0)).Y
		local bottomY = camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0)).Y
		local charSize = (bottomY - topY) / 2
		local boxSizeX = math.floor(charSize * 1.4)
		local boxSizeY = math.floor(charSize * 1.9)
		local boxPosX  = math.floor(hrp2D.X - charSize * 0.7)
		local boxPosY  = math.floor(hrp2D.Y - charSize * 0.8)
		local boxSize  = Vector2.new(boxSizeX, boxSizeY)
		local boxPosition = Vector2.new(boxPosX, boxPosY)
		if espConfig.ShowName then
			esp.name.Visible = true
			esp.name.Text = string.lower(player.Name)
			esp.name.Position = Vector2.new(boxPosX + boxSizeX / 2, boxPosY - 16)
			esp.name.Color = espConfig.NameColor
		else esp.name.Visible = false end
		if espConfig.ShowFilledBox then
			esp.filledBox.Position = boxPosition; esp.filledBox.Size = boxSize;
			esp.filledBox.Color = espConfig.FilledBoxColor; esp.filledBox.Visible = true;
		else esp.filledBox.Visible = false end
		if espConfig.ShowBox then
			local priority = getPlayerPriority(player)
			local boxColor
			if priority == "Friendly" then boxColor = Color3.fromRGB(0, 255, 0)
			elseif priority == "Enemy" then boxColor = Color3.fromRGB(255, 0, 0)
			else boxColor = espConfig.BoxColor end
			if espConfig.BoxType == "Normal" then
				esp.boxOutline.Size = boxSize; esp.boxOutline.Position = boxPosition;
				esp.box.Size = boxSize; esp.box.Position = boxPosition;
				esp.box.Color = boxColor; esp.box.Visible = true; esp.boxOutline.Visible = true;
				for _, line in ipairs(esp.boxLines) do line:Remove() end; esp.boxLines = {};
			elseif espConfig.BoxType == "Corner" then
				local lineW = boxSizeX / 3; local lineH = boxSizeY / 3;
				if #esp.boxLines == 0 then
					for i = 1, 16 do esp.boxLines[i] = createDrawing("Line", { Thickness = 1, Color = espConfig.BoxColor, Transparency = 1 }) end
				end
				local bl = esp.boxLines
				for i = 1, 8 do bl[i].Thickness = 2; bl[i].Color = espConfig.BoxOutlineColor; bl[i].Transparency = 1; end
				bl[1].From = Vector2.new(boxPosX, boxPosY); bl[1].To = Vector2.new(boxPosX, boxPosY + lineH);
				bl[2].From = Vector2.new(boxPosX, boxPosY); bl[2].To = Vector2.new(boxPosX + lineW, boxPosY);
				bl[3].From = Vector2.new(boxPosX + boxSizeX - lineW, boxPosY); bl[3].To = Vector2.new(boxPosX + boxSizeX, boxPosY);
				bl[4].From = Vector2.new(boxPosX + boxSizeX, boxPosY); bl[4].To = Vector2.new(boxPosX + boxSizeX, boxPosY + lineH);
				bl[5].From = Vector2.new(boxPosX, boxPosY + boxSizeY - lineH); bl[5].To = Vector2.new(boxPosX, boxPosY + boxSizeY);
				bl[6].From = Vector2.new(boxPosX, boxPosY + boxSizeY); bl[6].To = Vector2.new(boxPosX + lineW, boxPosY + boxSizeY);
				bl[7].From = Vector2.new(boxPosX + boxSizeX - lineW, boxPosY + boxSizeY); bl[7].To = Vector2.new(boxPosX + boxSizeX, boxPosY + boxSizeY);
				bl[8].From = Vector2.new(boxPosX + boxSizeX, boxPosY + boxSizeY - lineH); bl[8].To = Vector2.new(boxPosX + boxSizeX, boxPosY + boxSizeY);
				for i = 9, 16 do bl[i].From = bl[i-8].From; bl[i].To = bl[i-8].To; bl[i].Color = boxColor; end
				for _, line in ipairs(bl) do line.Visible = true end
				esp.box.Visible = false; esp.boxOutline.Visible = false;
			end
		else
			esp.box.Visible = false; esp.boxOutline.Visible = false;
			for _, line in ipairs(esp.boxLines) do line:Remove() end; esp.boxLines = {};
		end
		if espConfig.ShowHealth then
			if not _healthLerp[player] then _healthLerp[player] = humanoid.Health end
			local health
			if espConfig.AnimatedHealthBars then
				_healthLerp[player] = lerp(_healthLerp[player], humanoid.Health, 0.3)
				health = _healthLerp[player]
			else health = humanoid.Health end
			local healthPercentage = health / math.max(humanoid.MaxHealth, 1)
			local healthBarHeight  = healthPercentage * boxSizeY
			esp.healthOutline.From = Vector2.new(boxPosX - 6, boxPosY + boxSizeY + 1)
			esp.healthOutline.To   = Vector2.new(boxPosX - 6, boxPosY - 1)
			esp.health.From        = Vector2.new(boxPosX - 6, boxPosY + boxSizeY)
			esp.health.To          = Vector2.new(boxPosX - 6, boxPosY + boxSizeY - healthBarHeight + 1)
			esp.health.Color       = espConfig.HealthBasedColor and espConfig.HealthLowColor:Lerp(espConfig.HealthHighColor, healthPercentage) or espConfig.HealthColor
			esp.healthOutline.Visible = true; esp.health.Visible = true;
		else
			esp.healthOutline.Visible = false; esp.health.Visible = false; _healthLerp[player] = nil;
		end
		if espConfig.ShowDistance and client.Character and client.Character:FindFirstChild("HumanoidRootPart") then
			local distance = (client.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
			esp.distance.Text = string.format("%.1f studs", distance)
			esp.distance.Position = Vector2.new(boxPosX + boxSizeX / 2, boxPosY + boxSizeY + 5)
			esp.distance.Color = espConfig.DistanceColor; esp.distance.Visible = true;
		else esp.distance.Visible = false end
	end
end

