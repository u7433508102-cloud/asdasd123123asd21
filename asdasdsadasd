local headlessHeartbeat = nil
local originalTerrainColors = {}
local function applyHeadlessLocal(character, headlessAll)
	if not character then return end
	local head = character:FindFirstChild("Head")
	if head then
		head.LocalTransparencyModifier = 1
		local face = head:FindFirstChildOfClass("Decal")
		if face then face.Transparency = 1 end
	end
	if headlessAll then
		for _, accessory in ipairs(character:GetChildren()) do
			if accessory:IsA("Accessory") then
				local handle = accessory:FindFirstChild("Handle")
				if handle then handle.LocalTransparencyModifier = 1 end
			end
		end
	end
end

local function removeHeadlessLocal(character, restoreAccessories)
	if not character then return end
	local head = character:FindFirstChild("Head")
	if head then
		head.LocalTransparencyModifier = 0
		local face = head:FindFirstChildOfClass("Decal")
		if face then face.Transparency = 0 end
	end
	if restoreAccessories then
		for _, accessory in ipairs(character:GetChildren()) do
			if accessory:IsA("Accessory") then
				local handle = accessory:FindFirstChild("Handle")
				if handle then handle.LocalTransparencyModifier = 0 end
			end
		end
	end
end

local function startHeadlessHeartbeat()
	stopHeadlessHeartbeat()
	headlessHeartbeat = RunService.Heartbeat:Connect(function()
		local char = client.Character
		if not char then return end
		local misc = getgenv().ARCHNEM.misc
		if not misc.Headless and not misc.HeadlessAll then return end
		applyHeadlessLocal(char, misc.HeadlessAll)
	end)
	if getgenv().__ARCHNEM_RUNTIME then
		getgenv().__ARCHNEM_RUNTIME.headlessHeartbeatConn = headlessHeartbeat
	end
end

local function stopHeadlessHeartbeat()
	if headlessHeartbeat then
		headlessHeartbeat:Disconnect()
		headlessHeartbeat = nil
	end
	if getgenv().__ARCHNEM_RUNTIME then
		getgenv().__ARCHNEM_RUNTIME.headlessHeartbeatConn = nil
	end
end

local function updateHeadlessState(character)
	if not character then
		stopHeadlessHeartbeat()
		return
	end
	local misc = getgenv().ARCHNEM.misc
	removeHeadlessLocal(character, true)
	if misc.HeadlessAll or misc.Headless then
		applyHeadlessLocal(character, misc.HeadlessAll)
		startHeadlessHeartbeat()
	else
		stopHeadlessHeartbeat()
	end
end



