        tween(cardStroke, {Transparency = 1}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end

    cardBox.Active = true
    cardBox.MouseEnter:Connect(onEnter)
    cardBox.MouseLeave:Connect(onLeave)
    titleLabel.Active = true
    titleLabel.MouseEnter:Connect(onEnter)
    titleLabel.MouseLeave:Connect(onLeave)

