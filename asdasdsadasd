function applySkinChanger()
	if not getgenv().ARCHNEM.misc.SkinChanger.Enabled then return end
	local LocalPlayer = game:GetService("Players").LocalPlayer
	local Character = LocalPlayer.Character
	local Backpack = LocalPlayer:FindFirstChild("Backpack")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local WrapsFolder = ReplicatedStorage:FindFirstChild("Wraps")
	if not WrapsFolder then return end
	local KnivesFolder = ReplicatedStorage:FindFirstChild("Knives")
	local function findWeapon(container, weaponName)
		if not container then return nil end
		for _, item in ipairs(container:GetChildren()) do
			if item.Name == weaponName or item.Name == "[" .. weaponName .. "]" then return item end
		end
		return nil
	end
	local function removeSkinClones(weapon)
		if not weapon then return end
		for _, child in ipairs(weapon:GetChildren()) do
			if child:IsA("Model") and child.Name ~= "Handle" and child.Name ~= "Blade" then
				pcall(function() child:Destroy() end)
			end
		end
	end
	local function weldParts(part0, part1)
		if not part0 or not part1 then return end
		pcall(function()
			local existingWeld = part0:FindFirstChild("WeldConstraint")
			if existingWeld then existingWeld:Destroy() end
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = part0
			weld.Part1 = part1
			weld.Parent = part0
		end)
	end
	local function applySkinToWeapon(weapon, skinName, isWeapon)
		if not weapon then return end
		if not skinName or skinName == "Default" then
			local handle = weapon:FindFirstChild("Handle")
			if handle then handle.Transparency = 0 end
			removeSkinClones(weapon)
			return
		end
		local handle = weapon:FindFirstChild("Handle")
		if not handle then return end
		if isWeapon then
			local weaponWrapsFolder = WrapsFolder:FindFirstChild(weapon.Name)
			if not weaponWrapsFolder then weaponWrapsFolder = WrapsFolder:FindFirstChild("[" .. weapon.Name .. "]") end
			if not weaponWrapsFolder then return end
			local skinModel = weaponWrapsFolder:FindFirstChild(skinName)
			if not skinModel then
				for _, item in ipairs(weaponWrapsFolder:GetChildren()) do
					if item.Name:lower() == skinName:lower() then skinModel = item; break; end
				end
			end
			if not skinModel then return end
			removeSkinClones(weapon)
			local skinClone = skinModel:Clone()
			skinClone.Name = "SkinClone_" .. skinName
			skinClone.Parent = weapon
			local skinPrimaryPart = skinClone.PrimaryPart
			if not skinPrimaryPart then
				for _, part in ipairs(skinClone:GetDescendants()) do
					if part:IsA("BasePart") then skinPrimaryPart = part; pcall(function() skinClone.PrimaryPart = skinPrimaryPart end); break; end
				end
			end
			if not skinPrimaryPart then skinClone:Destroy(); return; end
			for _, part in ipairs(skinClone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false; part.Anchored = false; part.Massless = true;
					pcall(function() part.TopSurface = Enum.SurfaceType.Smooth; part.BottomSurface = Enum.SurfaceType.Smooth; end)
				end
			end
			pcall(function() skinClone:SetPrimaryPartCFrame(handle.CFrame) end)
			weldParts(handle, skinPrimaryPart)
			handle.Transparency = 1
		else
			if not KnivesFolder then return end
			local knifeModel = KnivesFolder:FindFirstChild(skinName)
			if not knifeModel then
				for _, item in ipairs(KnivesFolder:GetChildren()) do
					if item.Name:lower() == skinName:lower() then knifeModel = item; break; end
				end
			end
			if not knifeModel then return end
			removeSkinClones(weapon)
			local knifeClone = knifeModel:Clone()
			knifeClone.Name = "KnifeClone_" .. skinName
			knifeClone.Parent = weapon
			local knifePrimaryPart = knifeClone.PrimaryPart
			if not knifePrimaryPart then
				for _, part in ipairs(knifeClone:GetDescendants()) do
					if part:IsA("BasePart") then knifePrimaryPart = part; pcall(function() knifeClone.PrimaryPart = knifePrimaryPart end); break; end
				end
			end
			if not knifePrimaryPart then knifeClone:Destroy(); return; end
			for _, part in ipairs(knifeClone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false; part.Anchored = false; part.Massless = true;
					pcall(function() part.TopSurface = Enum.SurfaceType.Smooth; part.BottomSurface = Enum.SurfaceType.Smooth; end)
				end
			end
			pcall(function() knifeClone:SetPrimaryPartCFrame(handle.CFrame) end)
			weldParts(handle, knifePrimaryPart)
			handle.Transparency = 1
		end
	end
	local function applyToContainer(container)
		if not container then return end
		local weaponNames = {"DoubleBarrel", "Revolver", "TacticalShotgun", "SMG", "Shotgun"}
		for _, weaponName in ipairs(weaponNames) do
			local skinName = getgenv().ARCHNEM.misc.SkinChanger[weaponName]
			if skinName and skinName ~= "Default" then
				local weapon = findWeapon(container, weaponName)
				if weapon then applySkinToWeapon(weapon, skinName, true) end
			end
		end
		local knifeSkin = getgenv().ARCHNEM.misc.SkinChanger.Knife
		if knifeSkin and knifeSkin ~= "Default" then
			local knife = findWeapon(container, "Knife")
			if knife then applySkinToWeapon(knife, knifeSkin, false) end
		end
	end
	if Backpack then applyToContainer(Backpack) end
	if Character then applyToContainer(Character) end
end

