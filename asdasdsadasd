local renderConn = RunService.RenderStepped:Connect(function(dt)

	if getgenv().ARCHNEM.aimbot.Settings.UnlockOnOwnDeath and client.Character then
		local bodyEffects = client.Character:FindFirstChild("BodyEffects")
		if bodyEffects then
			local koValue = bodyEffects:FindFirstChild("K.O")
			if koValue and koValue.Value then aimbotActive = false; aimbotTarget = nil; end
		end
	end

	if getgenv().ARCHNEM.aimbot.Settings.Enabled and aimbotActive then
		if isPlayerKO(aimbotTarget) then aimbotActive = false; aimbotTarget = nil; end

		if aimbotTarget and aimbotTarget.Character then
			local settings = getgenv().ARCHNEM.aimbot.Settings
			local configuration = getgenv().ARCHNEM.aimbot.Configuration
			local part = aimbotTarget.Character:FindFirstChild(settings.Part)

			if not part then
				aimbotActive = false
				aimbotTarget = nil
			else
				local pos = part.Position

				if configuration.Prediction.Enabled and part.Velocity.Magnitude > 0.1 then
					local yVelocity = part.Velocity.Y
					local velocity = part.Velocity
					local predX = configuration.Prediction.New.X
					local predNewY = configuration.Prediction.New.Y
					if configuration.Prediction.JumpOffsetEnabled then
						if yVelocity > 0 then predNewY = configuration.Prediction.New.YJump or predNewY
						elseif yVelocity < -2 then predNewY = configuration.Prediction.New.YFall or predNewY end
					end
					pos = pos + Vector3.new(velocity.X / predX, velocity.Y / predNewY, velocity.Z / predX)
				end

				if configuration.Shake[1] then
					pos = pos + Vector3.new(
						math.random(-configuration.Shake[2], configuration.Shake[2]),
						math.random(-configuration.Shake[3], configuration.Shake[3]),
						math.random(-configuration.Shake[4], configuration.Shake[4])
					)
				end

				local currentCamPos = camera.CFrame.Position

				local finalPos = pos
					+ camera.CFrame.RightVector * (configuration.Offset and configuration.Offset.X or 0)
					+ camera.CFrame.UpVector   * (configuration.Offset and configuration.Offset.Y or 0)

				if configuration.PullResistance.Enabled then
					local resistStrength = configuration.PullResistance.Strength
					local currentLook = camera.CFrame.LookVector
					local toTarget = (finalPos - currentCamPos).Unit
					local mouseSpeed = mouseDelta.Magnitude
					local dynamicResist = resistStrength
					if mouseMoving and mouseSpeed > 1 then dynamicResist = math.min(1, resistStrength + (mouseSpeed / 100))
					elseif not mouseMoving then dynamicResist = math.max(0, resistStrength - 0.3) end
					local resistedDirection = currentLook:Lerp(toTarget, 1 - dynamicResist).Unit
					finalPos = currentCamPos + resistedDirection * (finalPos - currentCamPos).Magnitude
				end

				local goalCFrame = CFrame.new(currentCamPos, finalPos)

				local spam = configuration.Spam or { Enabled = false, Amount = 0 }
				local skipFrame = false
				if spam.Enabled then
					local dir = (finalPos - currentCamPos).Unit
					local dot = camera.CFrame.LookVector:Dot(dir)
					local angleDiff = math.acos(math.clamp(dot, -1, 1))
					if angleDiff <= math.rad(spam.Amount) then skipFrame = true end
				end

				if not skipFrame then
					if configuration.FrameSkip.Enabled then
						camera.CFrame = CFrame.new(currentCamPos, finalPos)
						configuration.FrameSkip.Enabled = false
					else
						local easingMode = settings.Easing
						local currentCF = camera.CFrame

						if configuration.Smooth.Enabled then
							local targetLook  = goalCFrame.LookVector
							local currentLook = currentCF.LookVector
							local horizontalTarget  = Vector3.new(targetLook.X,  0, targetLook.Z).Unit
							local horizontalCurrent = Vector3.new(currentLook.X, 0, currentLook.Z).Unit
							local smoothX = configuration.Smooth.X
							local smoothY = configuration.Smooth.Y

							if easingMode == "Delta2" then smoothX = Delta2Easing(smoothX); smoothY = Delta2Easing(smoothY);
							elseif easingMode == "Adaptive" then smoothX = AdaptiveEasing(smoothX, 1); smoothY = AdaptiveEasing(smoothY, 1);
							elseif easingMode == "Custom" then smoothX = CustomEasing(smoothX); smoothY = CustomEasing(smoothY);
							elseif easingMode == "Exit" then smoothX = exitEasing(smoothX); smoothY = exitEasing(smoothY); end

							local newHorizontal = horizontalCurrent:Lerp(horizontalTarget, smoothX)
							local verticalDiff  = targetLook.Y - currentLook.Y
							local newVertical   = currentLook.Y + verticalDiff * smoothY
							local magnitude     = math.sqrt(math.max(0, 1 - newVertical * newVertical))
							local newLook       = (newHorizontal * magnitude + Vector3.new(0, newVertical, 0)).Unit

							if configuration.CamSmooth.Enabled then
								local camSX = configuration.CamSmooth.X
								local camSY = configuration.CamSmooth.Y
								local blendedLook = currentLook:Lerp(newLook, math.clamp((camSX + camSY) * 0.5, 0.01, 1))
								camera.CFrame = CFrame.new(currentCamPos, currentCamPos + blendedLook)
							else
								camera.CFrame = CFrame.new(currentCamPos, currentCamPos + newLook)
							end
						else
							if configuration.CamSmooth.Enabled then
								local camSX = configuration.CamSmooth.X
								local camSY = configuration.CamSmooth.Y
								local alpha = math.clamp((camSX + camSY) * 0.5, 0.01, 1)
								local lerpedCF = currentCF:Lerp(goalCFrame, alpha)
								camera.CFrame = CFrame.new(currentCamPos, currentCamPos + lerpedCF.LookVector)
							else
								camera.CFrame = CFrame.new(currentCamPos, finalPos)
							end
						end
					end
				end
			end
		end
	end

	if Toggle360 and getgenv().ARCHNEM.Key360.Toggle then
		local CurrentTime = tick()
		local TimeDelta = math.min(CurrentTime - LastRenderTime360, 0.01)
		LastRenderTime360 = CurrentTime
		local Rotation = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), math.rad(getgenv().ARCHNEM.Key360.RotationSpeed * TimeDelta))
		camera.CFrame = camera.CFrame * Rotation
		TotalRotation360 = TotalRotation360 + math.rad(getgenv().ARCHNEM.Key360.RotationSpeed * TimeDelta)
		if TotalRotation360 >= FullCircleRotation then Toggle360 = false; TotalRotation360 = 0; end
	end

	updateFOVCircle()
	updateAimbotFOV()
	updateRadar()

	if getgenv().ARCHNEM.misc.Walkspeed.Enabled and getgenv().ARCHNEM.misc.Walkspeed.Active then
		applyWalkspeed()
	end
end)
getgenv().__ARCHNEM_RUNTIME.renderConn = renderConn

