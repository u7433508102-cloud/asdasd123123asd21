local function newPart(name, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.Locked = true
	p.Transparency = 1
	p.Massless = true
	pcall(function() p.CanQuery = false end)
	pcall(function() p.CanTouch = false end)
	p.Parent = parent
	return p
end

-- Камера может быть nil при старте скрипта или замениться при респауне.
-- Всегда берём актуальную CurrentCamera в момент использования.
local function resolveCamera()
	local current = workspace.CurrentCamera
	if current then camera = current end
	return camera
end

