        if active then
            tween(btn, {BackgroundColor3 = Color3.fromRGB(95, 14, 28)}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            tween(stroke, {Transparency = 0.44}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            btn.TextColor3 = COLORS.AccentGlow
        else
            tween(btn, {BackgroundColor3 = Color3.fromRGB(38, 18, 24)}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            tween(stroke, {Transparency = 0.76}, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            btn.TextColor3 = COLORS.TextPrimary
        end
    end

    btn.MouseEnter:Connect(function()
        if listening then return end
        tween(btn, {BackgroundColor3 = Color3.fromRGB(46, 22, 29)}, 0.12)
        tween(stroke, {Transparency = 0.6}, 0.12)
    end)

    btn.MouseLeave:Connect(function()
        if listening then return end
        setButtonVisual(false)
    end)

    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "..."
        setButtonVisual(true)

        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                listening = false
                btn.Text = getKeybindDisplayName(currentKey)
                setButtonVisual(false)
                conn:Disconnect()
                if callback then callback(currentKey) end
            end
        end)
    end)

    return {
        getKey = function() return currentKey end
    }
end

