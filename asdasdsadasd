local function updateRadar()
	_radarFrame = _radarFrame + 1
	if _radarFrame < 3 then return end
	_radarFrame = 0
	local radarConfig = getgenv().ARCHNEM.misc.Radar
	local radarEnabled = radarConfig.Enabled
	local radarSize = radarConfig.Size
	local radarRadius = radarSize / 2
	local radarPos = Vector2.new(radarConfig.Position[1] + radarRadius, radarConfig.Position[2] + radarRadius)
	radarBackground.Position = radarPos; radarBackground.Radius = radarRadius; radarBackground.Visible = radarEnabled;
	radarCircle.Position = radarPos; radarCircle.Radius = radarRadius; radarCircle.Visible = radarEnabled;
	radarLocalDot.Position = radarPos; radarLocalDot.Visible = radarEnabled;
	if radarLabels[1] then
		radarLabels[1].Position = Vector2.new(radarPos.X, radarPos.Y - radarRadius - 15); radarLabels[1].Visible = radarEnabled;
		radarLabels[2].Position = Vector2.new(radarPos.X + radarRadius + 15, radarPos.Y); radarLabels[2].Visible = radarEnabled;
		radarLabels[3].Position = Vector2.new(radarPos.X, radarPos.Y + radarRadius + 15); radarLabels[3].Visible = radarEnabled;
		radarLabels[4].Position = Vector2.new(radarPos.X - radarRadius - 15, radarPos.Y); radarLabels[4].Visible = radarEnabled;
	end
	if not radarEnabled then
		for _, arrow in pairs(radarArrows) do arrow.body.Visible = false; arrow.tip.Visible = false; end
		return
	end
	local localChar = client.Character
	if not localChar then return end
	local localRoot = localChar:FindFirstChild("HumanoidRootPart")
	if not localRoot then return end
	local arrowIndex = 1
	for _, player in ipairs(Players:GetPlayers()) do
		if player == client then continue end
		local char = player.Character
		if not char then continue end
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end
		local distance = (localRoot.Position - root.Position).Magnitude
		if distance > radarConfig.Distance then continue end
		local relativePos = localRoot.CFrame:PointToObjectSpace(root.Position)
		local scale = radarRadius / radarConfig.Distance
		local dotX = radarPos.X + relativePos.X * scale
		local dotY = radarPos.Y + relativePos.Z * scale
		if math.sqrt((relativePos.X * scale)^2 + (relativePos.Z * scale)^2) > radarRadius then continue end
		if not radarArrows[arrowIndex] then radarArrows[arrowIndex] = createArrow() end
		local arrow = radarArrows[arrowIndex]
		local lookVector = root.CFrame.LookVector
		local localLookVector = localRoot.CFrame.LookVector
		local relativeAngle = math.atan2(lookVector.X, lookVector.Z) - math.atan2(localLookVector.X, localLookVector.Z)
		local color
		if radarConfig.Friends and client:IsFriendsWith(player.UserId) then color = Color3.fromRGB(0, 255, 0)
		else color = Color3.fromRGB(85, 122, 255) end
		drawArrow(arrow, Vector2.new(dotX, dotY), relativeAngle, color)
		arrowIndex = arrowIndex + 1
	end
	for i = arrowIndex, #radarArrows do radarArrows[i].body.Visible = false; radarArrows[i].tip.Visible = false; end
end

