        tween(cardBox, {BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(10, 10, 11)}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        tween(titleLabel, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.18)
        -- черная обводка пожирнее
        tween(cardStroke, {Transparency = 0.5, Thickness = 2.6}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end

