local function rotatePoint(point, center, angle)
	local s, c = math.sin(angle), math.cos(angle)
	local x = point.X - center.X
	local y = point.Y - center.Y
	return Vector2.new(x * c - y * s + center.X, x * s + y * c + center.Y)
end

local function drawArrow(arrow, position, rotation, color)
	local bodyLength = 10
	local tipSize = 6
	local bodyStart = rotatePoint(Vector2.new(position.X, position.Y + bodyLength / 2), position, rotation)
	local bodyEnd   = rotatePoint(Vector2.new(position.X, position.Y - bodyLength / 2 + tipSize / 2), position, rotation)
	arrow.body.From = bodyStart
	arrow.body.To   = bodyEnd
	arrow.body.Color = color
	arrow.body.Visible = true
	local tipTop   = rotatePoint(Vector2.new(position.X, position.Y - bodyLength / 2 - tipSize / 2), position, rotation)
	local tipLeft  = rotatePoint(Vector2.new(position.X - tipSize / 2, position.Y - bodyLength / 2 + tipSize / 2), position, rotation)
	local tipRight = rotatePoint(Vector2.new(position.X + tipSize / 2, position.Y - bodyLength / 2 + tipSize / 2), position, rotation)
	arrow.tip.PointA = tipTop
	arrow.tip.PointB = tipLeft
	arrow.tip.PointC = tipRight
	arrow.tip.Color = color
	arrow.tip.Visible = true
end

