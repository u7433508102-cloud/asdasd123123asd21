    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local labelStroke = Instance.new("UIStroke")
    labelStroke.Color = Color3.fromRGB(0, 0, 0)
    labelStroke.Thickness = 1.0
    labelStroke.Transparency = 0
    labelStroke.Parent = label

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.35, 0, 0, 20)
    valueLabel.Position = UDim2.new(0.65, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = isFloat and string.format("%.1f", val) or string.format("%.1f", val)
    valueLabel.FontFace = UI_FONT
    valueLabel.TextSize = 11
    valueLabel.TextColor3 = COLORS.TextPrimary
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = row

    local valueStroke = Instance.new("UIStroke")
    valueStroke.Color = Color3.fromRGB(0, 0, 0)
    valueStroke.Thickness = 1.0
    valueStroke.Transparency = 0
    valueStroke.Parent = valueLabel

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 26)
    track.BackgroundColor3 = COLORS.CheckboxBg
    track.ClipsDescendants = false
    track.Parent = row

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(0, 0)
    trackCorner.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((val - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = COLORS.Accent
    fill.ClipsDescendants = true
    fill.Parent = track

    -- красивый градиент: светлый в начале -> темнее в конце
    local fillGradient = Instance.new("UIGradient")
    fillGradient.Color = ColorSequence.new{ColorSequenceKeypoint.new(0.0, Color3.fromRGB(160, 20, 30)), ColorSequenceKeypoint.new(1.0, Color3.fromRGB(0, 0, 0))}
    fillGradient.Rotation = 0
    fillGradient.Parent = fill

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 0)
    fillCorner.Parent = fill

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 4, 0, 14)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.new((val - minVal) / (maxVal - minVal), 0, 0.5, 0)
    thumb.BackgroundColor3 = COLORS.TextPrimary
    thumb.ZIndex = 3
    thumb.Parent = track

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(0, 0)
    thumbCorner.Parent = thumb

    local draggingSlider = false

    local function updateValue(inputPos)
        local percent = math.clamp((inputPos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        val = minVal + percent * (maxVal - minVal)
        if not isFloat then val = math.floor(val + 0.5) end
        fill.Size = UDim2.new(percent, 0, 1, 0)
        thumb.Position = UDim2.new(percent, 0, 0.5, 0)
        valueLabel.Text = isFloat and string.format("%.2f", val) or tostring(val)
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(input)
        if inputActive then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mousePos = UserInputService:GetMouseLocation()
            local valueAbsPos = valueLabel.AbsolutePosition
            local valueAbsSize = valueLabel.AbsoluteSize
            -- Ignore clicks over value label area so typing isn't interrupted
            local overValue = mousePos.X >= valueAbsPos.X and mousePos.X <= valueAbsPos.X + valueAbsSize.X and mousePos.Y >= valueAbsPos.Y and mousePos.Y <= valueAbsPos.Y + valueAbsSize.Y
            if overValue then return end
            draggingSlider = true
            updateValue(input.Position)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingSlider = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if inputActive or not draggingSlider then return end
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input.Position)
        end
    end)

    local inputActive = false

    valueLabel.Active = true
    valueLabel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            inputActive = true
            -- Replace label with inline input box temporarily
            local inputBox = Instance.new("TextBox")
            inputBox.Name = "ValueInput"
            inputBox.Size = UDim2.new(0.35, 0, 0, 20)
            inputBox.Position = UDim2.new(0.65, 0, 0, 0)
            inputBox.BackgroundTransparency = 1
            inputBox.Text = tostring(val)
            inputBox.FontFace = UI_FONT
            inputBox.TextSize = 11
            inputBox.TextColor3 = COLORS.TextPrimary
            inputBox.TextXAlignment = Enum.TextXAlignment.Right
            inputBox.ZIndex = 10
            inputBox.Parent = row
            valueLabel.Visible = false
            inputBox:CaptureFocus()

            local apply = function()
                inputActive = false
                local text = inputBox.Text
                local number = tonumber(text)
                if number then
                    val = math.clamp(number, minVal, maxVal)
                    local percent = (val - minVal) / (maxVal - minVal)
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    thumb.Position = UDim2.new(percent, 0, 0.5, 0)
                    valueLabel.Text = isFloat and string.format("%.2f", val) or tostring(val)
                    if callback then callback(val) end
                end
                valueLabel.Visible = true
                inputBox:Destroy()
            end

            -- Only apply when clicking outside (not on FocusLost to avoid LMB reset)
            UserInputService.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mousePos = UserInputService:GetMouseLocation()
                    local absPos = inputBox.AbsolutePosition
                    local absSize = inputBox.AbsoluteSize
                    local inside = mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y
                    if not inside then
                        apply()
                    end
                end
            end)
        end
    end)

    return {
        setValue = function(newVal)
            val = math.clamp(newVal, minVal, maxVal)
            local percent = (val - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            thumb.Position = UDim2.new(percent, 0, 0.5, 0)
            valueLabel.Text = isFloat and string.format("%.2f", val) or tostring(val)
        end,
        getValue = function() return val end
    }
end

